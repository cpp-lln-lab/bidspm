BootStrap: docker
From: ubuntu:jammy-20240808

%files
    pyproject.toml /opt/bidspm/pyproject.toml
    uv.lock /opt/bidspm/uv.lock
    README.md  /opt/bidspm/README.md
    bidspm.m /opt/bidspm/bidspm.m
    src /opt/bidspm/src
    lib /opt/bidspm/lib
    .git /opt/bidspm/.git

%post
    apt-get -qq update
    DEBIAN_FRONTEND=noninteractive apt-get --yes --quiet install \
        apt-utils \
        build-essential \
        ca-certificates \
        curl \
        default-jre \
        fonts-freefont-otf \
        ghostscript \
        git \
        gnuplot-x11 \
        libcurl4-gnutls-dev \
        liboctave-dev \
        octave \
        octave-common \
        octave-io \
        octave-image \
        octave-signal \
        octave-statistics \
        python3-pip \
        python3 \
        software-properties-common \
        unzip \
        zip && \
    apt-get clean && \
    rm -rf \
        /tmp/hsperfdata* \
        /var/*/apt/*/partial \
        /var/lib/apt/lists/* \
        /var/log/apt/term*

    curl -fsSL https://deno.land/install.sh | sh
    export DENO_INSTALL="/root/.deno"
    export PATH="$DENO_INSTALL/bin:$PATH"
    deno install -Agf -n bids-validator jsr:@bids/validator@1.14.12

    SPM_VERSION=26.10.01
    curl -fsSL --retry 5 -o /tmp/spm.zip https://github.com/spm/spm/releases/download/${SPM_VERSION}/spm_${SPM_VERSION}.zip
    unzip -q /tmp/spm.zip -d /opt
    rm /tmp/spm.zip
    make -C /opt/spm/src PLATFORM=octave distclean
    make -C /opt/spm/src PLATFORM=octave
    make -C /opt/spm/src PLATFORM=octave install
    ln -s /opt/spm/bin/spm-octave /usr/local/bin/spm

    git -C /opt/bidspm restore .
    git -C /opt/bidspm/ submodule foreach --recursive 'git reset --hard'
    git -C /opt/bidspm/ submodule foreach --recursive 'git clean --force -dfx'
    git -C /opt/bidspm/ status

    curl -LsSf https://astral.sh/uv/0.13.5/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh
    export UV_PYTHON_INSTALL_DIR=/opt/uv/python
    export UV_PROJECT_ENVIRONMENT=/opt/venv
    export UV_NO_CACHE=1
    cd /opt/bidspm && uv sync --locked --no-dev --no-editable --python 3.12 && cd -
    octave --no-gui --eval "addpath('/opt/spm/'); savepath ('/usr/share/octave/site/m/startup/octaverc');" && \
    octave --no-gui --eval "addpath('/opt/bidspm/'); savepath('/usr/share/octave/site/m/startup/octaverc'); bidspm(); path"  && \
    octave --no-gui --eval "path"

%environment
    export PATH="/opt/venv/bin:${PATH}"

%runscript
    bidspm "$@"

%help
    This is a bidspm container.
    Please see the documentation for more instructions:
    https://bidspm.readthedocs.io/en/latest/
